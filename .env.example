# Copy to .env for local development. Never commit .env or real tokens.
REDMIND_ENVIRONMENT=local
LOG_LEVEL=INFO

# Production example:
# REDMIND_ENVIRONMENT=production
# REDMIND_DATABASE_URL=postgresql+asyncpg://redmind:change-me@127.0.0.1/redmind
# REDMIND_VIEWER_TOKEN=replace-with-at-least-32-random-characters
# REDMIND_AUDITOR_TOKEN=replace-with-another-32-random-characters
# REDMIND_AUDIT_SIGNING_KEY=replace-with-at-least-32-random-characters
# REDMIND_OTEL_SERVICE_NAME=redmind-observer
# REDMIND_OTLP_ENDPOINT=http://127.0.0.1:4318
